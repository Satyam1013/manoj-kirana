{
  "name": "bahi-khata-backend",
  "version": "1.0.0",
  "description": "Backend API for Bahi Khata (Manoj Kirana Dukan & Cold Storage) — NestJS + MongoDB",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
